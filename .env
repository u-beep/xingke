# Copy this file to .env and fill only the providers you use.

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
PICO_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
PICO_DEEPSEEK_API_KEY=sk-985876e3746e43cb9404466d9300d26c
PICO_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
PICO_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
PICO_OPENAI_API_BASE=https://www.right.codes/codex/v1
PICO_OPENAI_API_KEY=
PICO_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse PICO_RIGHT_CODES_API_KEY when your gateway shares one key.
PICO_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
PICO_ANTHROPIC_API_KEY=
PICO_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
PICO_SECRET_ENV_NAMES=

# ─── ShapeAI 身材管理AI中台 配置 ───

# 主模型（美团 AIGC 网关，OpenAI 兼容协议）
# 注: 目标方案是 deepseek-v4-pro（对话+Agent 旗舰），但当前 Key 未开通 v4-pro 配额（持续 429），
#     先用 v4-flash 主力、v4-flash-vision-exp 兑底；待 AIGC 平台申请到 v4-pro 权限后，
#     将 SHAPEAI_PRIMARY_MODEL 改回 deepseek-v4-pro、FALLBACK 改回 deepseek-v4-flash 即可
SHAPEAI_PRIMARY_MODEL=deepseek-v4-flash
SHAPEAI_PRIMARY_BASE_URL=https://aigc.sankuai.com/v1/openai/native
SHAPEAI_PRIMARY_API_KEY=22021108725645484118

# 备用模型（主模型故障时降级）
SHAPEAI_FALLBACK_MODEL=deepseek-v4-flash-vision-exp
SHAPEAI_FALLBACK_BASE_URL=https://aigc.sankuai.com/v1/openai/native
SHAPEAI_FALLBACK_API_KEY=22021108725645484118

# 视觉模型（拍照识别专用，DeepSeek 系唯一多模态）
SHAPEAI_VISION_MODEL=deepseek-v4-flash-vision-exp
SHAPEAI_VISION_BASE_URL=https://aigc.sankuai.com/v1/openai/native
SHAPEAI_VISION_API_KEY=22021108725645484118

# 模型参数
# 注: deepseek-v4 系列均为推理模型，思考内容(reasoning)也占用输出额度，
#     2048 容易被思考耗尽导致正文截断，调大到 8192
SHAPEAI_MODEL_TIMEOUT=300
SHAPEAI_TEMPERATURE=0.3
SHAPEAI_MAX_TOKENS=8192

# Agent 配置
SHAPEAI_MAX_STEPS=8
SHAPEAI_CONTEXT_BUDGET=12000

# API 服务配置
# 注: 8900/18900 被占用,改用 28900
SHAPEAI_HOST=0.0.0.0
SHAPEAI_PORT=28900
SHAPEAI_API_KEY=shapeai-dev-key
