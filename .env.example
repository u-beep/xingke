# Copy this file to .env and fill only the providers you use.

# ─── ShapeAI 身材管理AI中台 配置 ───

# 主模型（DeepSeek，Anthropic兼容协议）
SHAPEAI_PRIMARY_MODEL=deepseek-v4-pro
SHAPEAI_PRIMARY_BASE_URL=https://api.deepseek.com/anthropic
SHAPEAI_PRIMARY_API_KEY=

# 备用模型（通义千问，OpenAI兼容协议）
SHAPEAI_FALLBACK_MODEL=qwen-plus
SHAPEAI_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
SHAPEAI_FALLBACK_API_KEY=

# 视觉模型（DeepSeek 多模态，OpenAI 兼容 chat completions，用于冰箱拍照识别食材）
SHAPEAI_VISION_MODEL=deepseek-v4-flash-vision-exp
SHAPEAI_VISION_BASE_URL=https://api.deepseek.com
SHAPEAI_VISION_API_KEY=

# 模型参数
SHAPEAI_MODEL_TIMEOUT=300
SHAPEAI_TEMPERATURE=0.3
SHAPEAI_MAX_TOKENS=2048

# Agent 配置
SHAPEAI_MAX_STEPS=8
SHAPEAI_CONTEXT_BUDGET=12000

# API 服务配置
SHAPEAI_HOST=0.0.0.0
SHAPEAI_PORT=8900
SHAPEAI_API_KEY=shapeai-dev-key

# ─── 数据库配置 ───

# PostgreSQL (主数据库, compose 映射 5433->5432)
SHAPEAI_PG_HOST=localhost
SHAPEAI_PG_PORT=5433
SHAPEAI_PG_DB=shapeai
SHAPEAI_PG_USER=shapeai
SHAPEAI_PG_PASSWORD=shapeai123

# Redis (缓存/短期记忆, compose 映射 6380->6379)
SHAPEAI_REDIS_HOST=localhost
SHAPEAI_REDIS_PORT=6380
SHAPEAI_REDIS_DB=0
SHAPEAI_REDIS_PASSWORD=

# Milvus (向量检索)
SHAPEAI_MILVUS_HOST=localhost
SHAPEAI_MILVUS_PORT=19530
SHAPEAI_MILVUS_COLLECTION=shapeai_knowledge

# MySQL (同步副本, compose 映射 3307->3306)
SHAPEAI_MYSQL_HOST=localhost
SHAPEAI_MYSQL_PORT=3307
SHAPEAI_MYSQL_DB=shapeai
SHAPEAI_MYSQL_USER=root
SHAPEAI_MYSQL_PASSWORD=123456

# MinIO (对象存储, 冰箱食材图片, 复用 docker-compose 已有 minio 服务, 映射 9001->9000)
SHAPEAI_MINIO_ENDPOINT=localhost:9001
SHAPEAI_MINIO_ACCESS_KEY=minioadmin
SHAPEAI_MINIO_SECRET_KEY=minioadmin
SHAPEAI_MINIO_SECURE=false
SHAPEAI_MINIO_BUCKET=fridge-images

# PG -> MySQL 定时同步
SHAPEAI_SYNC_ENABLED=true
SHAPEAI_SYNC_INTERVAL=60

# 知识爬虫 (定时拉取营养学网站知识到 Milvus, 已禁用, 需要时改为 true)
SHAPEAI_CRAWLER_ENABLED=false
SHAPEAI_CRAWLER_INTERVAL=3600
SHAPEAI_CRAWLER_TIMEOUT=30
